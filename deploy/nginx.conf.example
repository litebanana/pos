# Use a dedicated HTTPS origin for Tindahan, not a directory shared with other apps.
# Replace hostname, certificate paths, and the filesystem root for your host.
server {
    listen 80;
    server_name pos.your-store.example;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name pos.your-store.example;
    ssl_certificate /etc/letsencrypt/live/pos.your-store.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pos.your-store.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /var/www/tindahan/dist;
    index index.html;
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Generated by npm run build from the same policy used by production preview.
    # Nginx inherits these headers into the locations below.
    include /var/www/tindahan/dist/security-headers.nginx.conf;

    location = /sw.js {
        expires -1;
        try_files $uri =404;
    }
    location = /manifest.webmanifest {
        expires -1;
        try_files $uri =404;
    }
    location = /index.html {
        expires -1;
    }
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
